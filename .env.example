# ============================================================
# RegulaFlow — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# .env is in .gitignore and will NEVER be committed.
# .env.example IS committed — it shows teammates what variables exist.
# ============================================================

# Application
APP_NAME=RegulaFlow
ENVIRONMENT=development      # development | production | testing
DEBUG=false
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ============================================================
# Variables to be added in future sessions:
# ============================================================

# Session 10 — OpenAI provider
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Session 13 — PostgreSQL database
# DATABASE_URL=postgresql://user:password@localhost:5432/regulaflow

# Session 44 — Redis cache
# REDIS_URL=redis://localhost:6379/0
